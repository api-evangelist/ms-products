{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Graph API (v1.0) Calendar Groups API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List groups in the directory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/groups"
          },
          "docs": "List groups in the directory"
        },
        {
          "info": {
            "name": "Get a group by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/groups/:groupId",
            "params": [
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "Group id."
              }
            ]
          },
          "docs": "Get a group by id"
        },
        {
          "info": {
            "name": "List members of a group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/groups/:groupId/members",
            "params": [
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "Group id."
              }
            ]
          },
          "docs": "List members of a group"
        }
      ]
    }
  ],
  "bundled": true
}